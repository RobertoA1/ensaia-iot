# La clave de OpenAI SOLO se guarda en la laptop.
OPENAI_API_KEY=
LIVE_MODEL=gpt-live-1
LIVE_VOICE=marin
# Generados por: python tools/configurar.py --ip IP_DE_LA_LAPTOP
APP_TOKEN=CAMBIAR
MQTT_USER=oratoria
MQTT_PASSWORD=CAMBIAR
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_BIND=0.0.0.0
DEVICE_ID=esp8266-oratoria
BUILTIN_BROKER=true
SIMULATE_DEVICE=false
MAX_SESSION_SECONDS=300
ALLOW_DEMO=true
DATA_DIR=data
