listeners.tcp.default.enable = false
listeners.ssl.default.enable = false
listeners.ws.default.enable = false
listeners.wss.default {
  enable = true
  bind = "0.0.0.0:8084"
  websocket.mqtt_path = "/mqtt"
  ssl_options {
    certfile = "/opt/emqx/etc/ensaia/server.crt"
    keyfile = "/opt/emqx/etc/ensaia/server.key"
    versions = ["tlsv1.3", "tlsv1.2"]
  }
}

authentication = [{
  mechanism = password_based
  backend = built_in_database
  user_id_type = username
  password_hash_algorithm { name = sha256, salt_position = suffix }
  bootstrap_file = "/opt/emqx/etc/ensaia/users.csv"
  bootstrap_type = plain
}]

authorization {
  no_match = deny
  deny_action = ignore
  sources = [{ type = file, enable = true, path = "/opt/emqx/etc/ensaia/acl.conf" }]
}
