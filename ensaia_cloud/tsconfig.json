{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "noEmit": true, "types": ["node"], "allowImportingTsExtensions": true
  },
  "include": ["api", "lib", "src", "scripts", "tests", "vite.config.ts"]
}
